# Copie ce fichier vers .env en développement local.
# En production, renseigner ces valeurs dans les variables d’environnement du fournisseur.
AEROMIND_ENV=development
PORT=10000
AEROMIND_SESSION_SECRET=replace-with-at-least-32-random-bytes
AEROMIND_ALLOWED_HOSTS=localhost,127.0.0.1
AEROMIND_ALLOWED_ORIGINS=http://localhost:5173
AEROMIND_SUPERADMIN_EMAILS=
AEROMIND_TRIAL_EMAILS=demo@example.com
DEFAULT_DEMO_EMAIL=
DATABASE_URL=sqlite:///./data/aeromind.db
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
# OPENAI_API_KEY=
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=
